{
    "manifest_version": 3,
    "name": "Chatgpt Logs Record",
    "version": "1.0",
    "description": "Record and search chatgpt logs",
    "permissions": [
        "activeTab"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://chatgpt.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}